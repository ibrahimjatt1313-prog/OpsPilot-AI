# ==============================================================================
# OPSPILOT AI - ENVIRONMENT CONFIGURATION (HACKATHON EDITION)
# ==============================================================================

# Port for Express API server
PORT=5000

# Google Cloud Gemini API Key
# Obtain your free API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Ultra-fast cloud model for container and database log interpretation
# Supported: gemini-3.6-flash, gemini-3.5-flash, gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.6-flash
